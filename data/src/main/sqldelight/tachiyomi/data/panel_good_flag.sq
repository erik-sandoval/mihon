CREATE TABLE panel_good_flag(
    chapter_id INTEGER NOT NULL,
    page_index INTEGER NOT NULL,
    PRIMARY KEY (chapter_id, page_index),
    FOREIGN KEY(chapter_id) REFERENCES chapters (_id)
    ON DELETE CASCADE
);

isMarkedGood:
SELECT 1
FROM panel_good_flag
WHERE chapter_id = :chapterId
AND page_index = :pageIndex
LIMIT 1;

setMarkedGood:
INSERT OR IGNORE INTO panel_good_flag(chapter_id, page_index)
VALUES (:chapterId, :pageIndex);

removeMarkedGood:
DELETE FROM panel_good_flag
WHERE chapter_id = :chapterId
AND page_index = :pageIndex;
